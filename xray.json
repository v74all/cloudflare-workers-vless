{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    },
    {
      "port": 10809,
      "listen": "127.0.0.1",
      "protocol": "http"
    }
  ],
  "outbounds": [
    {
      "tag": "worker-vless",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "104.16.132.229",
            "port": 443,
            "users": [
              {
                "id": "d3b07384-d113-49d6-a2a4-b885315e34b1",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "vless-edge.workers.dev",
          "fingerprint": "chrome"
        },
        "wsSettings": {
          "path": "/vless",
          "headers": {
            "Host": "vless-edge.workers.dev"
          }
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "domain": ["geosite:category-ir"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": ["geoip:ir", "geoip:private"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "worker-vless"
      }
    ]
  }
}
